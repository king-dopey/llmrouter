# =============================================================================
# Orin Profile — Hardware-Specific Settings (Jetson AGX Orin 64 GB)
# =============================================================================
# This file contains environment variables specific to the Jetson AGX Orin
# platform. It is sourced by docker-compose.yml when HARDWARE_PROFILE=orin.
#
# Platform specifications:
#   - CPU: ARM64 (aarch64) 8-core Cortex-A78AE
#   - GPU: NVIDIA Ampere SM 87 (384 CUDA cores)
#   - RAM: 64 GB unified LPDDR5
#   - Architecture: System-on-Module (SoM) with shared CPU/GPU memory
#
# These variables override defaults from profiles/global.env for the Orin profile.
# To customize model behavior, edit profiles/orin/models.yaml instead.
# =============================================================================

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------

# Default model ID — the primary chat model used when no model is specified
# in client requests (e.g., LibreChat default model selection). This model
# should be pulled into the Ollama instance before deployment.
#
# The Orin profile uses qwen3.6:35b-a3b-q8_0 as the default because it offers
# a good balance of capability and memory efficiency on 64 GB unified memory.
# The q8_0 quantization provides near-full-precision quality while using ~18 GB
# of resident memory, leaving headroom for KV cache and concurrent models.
#
# Valid: any Ollama-compatible model ID pulled into the local Ollama instance
# Recommended alternatives:
#   - qwen3.6:35b-a3b        (unquantized, ~70 GB — exceeds Orin memory)
#   - qwen3.6:35b-a3b-q4_K_M (~19 GB — lower quality but fits comfortably)
#   - devstral-small:24b     (~12 GB — faster but less capable)
# Avoid models larger than ~40 GB as they leave insufficient headroom for KV cache.
MODEL_DEFAULT=qwen3.6:35b-a3b-q8_0

# -----------------------------------------------------------------------------
# Embedding Configuration
# -----------------------------------------------------------------------------

# Default embedding model ID — the Ollama model used to generate embeddings for
# OpenAI-compatible /v1/embeddings endpoints. This is separate from the Qdrant
# embedding model (QDRANT_EMBEDDING_MODEL in profiles/global.env) and is used
# when clients request embeddings directly through the router.
#
# The qwen3-embedding:4b model is chosen for its balance of embedding quality
# and inference speed on ARM64 hardware. It produces 4096-dimensional vectors
# compatible with Qdrant's default distance metric (COSINE).
#
# Valid: any Ollama-compatible embedding model
# Recommended alternatives:
#   - nomic-embed-text:v1.5   (768-dim, faster but lower quality)
#   - mxbai-embed-large:v1    (1024-dim, higher quality but slower)
# Note: The embedding model must match the one used during document ingestion
# to ensure consistent vector representations in Qdrant.
EMBEDDING_MODEL_DEFAULT=qwen3-embedding:4b
