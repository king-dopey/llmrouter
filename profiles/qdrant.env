# =============================================================================
# Qdrant Environment Variables — profiles/qdrant.env
# =============================================================================
# This file contains environment variables specific to the qdrant container.
# These are sourced via Docker Compose env_file directive.
#
# Variables in this file are NOT shared with the router container.
# =============================================================================

# -----------------------------------------------------------------------------
# Qdrant Client/Consumer Settings
# -----------------------------------------------------------------------------

# Enable or disable retrieval-augmented generation (RAG) via Qdrant.
ENABLE_QDRANT_RETRIEVAL=true

# Qdrant service URL — the address the router uses to connect to Qdrant.
QDRANT_URL=http://qdrant:6333

# Qdrant collection name — the vector collection used for document storage.
QDRANT_COLLECTION=repo_chunks

# Embedding model ID — the Ollama model used to generate vector embeddings.
QDRANT_EMBEDDING_MODEL=qwen3-embedding:4b

# Maximum number of candidate documents to retrieve from Qdrant.
QDRANT_TOP_K=20

# Final number of documents passed to the LLM after re-ranking/filtering.
QDRANT_FINAL_K=8

# -----------------------------------------------------------------------------
# Qdrant Service Deployment Settings
# -----------------------------------------------------------------------------

# Enable or disable GPU-accelerated vector indexing in Qdrant.
QDRANT_GPU_INDEXING=false

# Disable Qdrant telemetry reporting.
QDRANT__TELEMETRY_DISABLED=true

# Maximum memory allocation for Qdrant optimizer operations in bytes.
QDRANT_OPTIMIZERS_MAX_MEMORY_BYTES=4294967296

# Enable or disable Qdrant clustering for distributed deployments.
QDRANT_CLUSTER_ENABLE=false

# Rust logging level for Qdrant container output.
RUST_LOG=info
