# =============================================================================
# Router Environment Variables — profiles/router.env
# =============================================================================
# This file contains environment variables specific to the fastapi-router
# container. These are sourced via Docker Compose env_file directive.
#
# Variables in this file are NOT shared with the qdrant container.
# =============================================================================

# -----------------------------------------------------------------------------
# Network Configuration
# -----------------------------------------------------------------------------

# Ollama backend URL — the host where Ollama serves LLM inference endpoints.
OLLAMA_BASE_URL=http://ollama:11434

# Router HTTP port — the port exposed by the OpenAI-compatible API router.
ROUTER_INTERNAL_PORT=4000

# -----------------------------------------------------------------------------
# Router Policy Configuration
# -----------------------------------------------------------------------------

# Default keep_alive duration — how long loaded models stay resident in Ollama.
KEEP_ALIVE_DEFAULT=-1

# Proxy-side think policy for Ollama requests.
DISABLE_THINK_TOOL_PATTERNS=web_search,search,browser,browse,serp,http_get,http,fetch,scrape
DISABLE_THINK_SUMMARY_PATTERNS=summarize,tl;dr,tldr,bullet summary,key takeaways
DISABLE_THINK_CHAR_THRESHOLD=12000

# -----------------------------------------------------------------------------
# Auto-Pull Configuration (Router -> Ollama)
# -----------------------------------------------------------------------------

# When true, the router automatically pulls missing models from the Ollama
# registry during startup warmup and during request preflight validation.
# When false, missing models are logged as warnings but not pulled automatically.
# Default: false (set to true to enable auto-pull during warmup)
AUTO_PULL_MISSING_MODELS=true

# Maximum time in seconds to wait for a model pull to complete.
# Large models (30B+) may require several minutes to download.
MODEL_PULL_TIMEOUT_SEC=7200

# Reserved for future use — retry/backoff for pull operations.
MODEL_PULL_MAX_RETRIES=2
MODEL_PULL_BACKOFF_SEC=5

# -----------------------------------------------------------------------------
# Headroom-AI Context Management
# -----------------------------------------------------------------------------

HEADROOM_ENABLED=1

# -----------------------------------------------------------------------------
# Headroom-AI Cache Configuration
# -----------------------------------------------------------------------------

# Hugging Face model cache directory (for kompress-v2-base ONNX model download)
HF_HOME=/data/hf_cache
HUGGINGFACE_HUB_CACHE=/data/hf_cache/hub
TRANSFORMERS_CACHE=/data/hf_cache/models

# Headroom CCR store path (for persistent retrieval data)
HEADROOM_CCR_STORE_PATH=/data/headroom_ccr

# -----------------------------------------------------------------------------
# Headroom-AI Compression Configuration
# -----------------------------------------------------------------------------

# Enable relevance scoring (requires [relevance] extra)
HEADROOM_RELEVANCE_ENABLED=1

# Enable or disable telemetry
HEADROOM_TELEMETRY=off