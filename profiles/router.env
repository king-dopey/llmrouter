# =============================================================================
# Router Environment Variables — profiles/router.env
# =============================================================================
# This file contains environment variables specific to the fastapi-router
# container. These are sourced via Docker Compose env_file directive.
#
# Variables in this file are NOT shared with the qdrant container.
# =============================================================================

# -----------------------------------------------------------------------------
# Network Configuration
# -----------------------------------------------------------------------------

# Ollama backend URL for the LLM inference service. The router posts finalized
# chat payloads here after compaction and optional retrieval/context injection.
OLLAMA_BASE_URL=http://ollama:11434

# Internal router HTTP port exposed by the FastAPI service inside the container.
ROUTER_INTERNAL_PORT=4000

# -----------------------------------------------------------------------------
# Router Policy Configuration
# -----------------------------------------------------------------------------

# Default Ollama keep_alive value for models that do not specify a per-model
# override. Use -1 to keep a model resident in memory after first load.
KEEP_ALIVE_DEFAULT=-1

# Maximum character count before the router forces think=false on long prompts
# that are likely to be too verbose for a lower-latency, more direct answer.
DISABLE_THINK_CHAR_THRESHOLD=12000

# -----------------------------------------------------------------------------
# Auto-Pull Configuration (Router -> Ollama)
# -----------------------------------------------------------------------------

# When true, the router auto-pulls missing models during startup warmup and
# during per-request preflight validation. When false, missing models log a
# warning and rely on the operator to pull them manually.
AUTO_PULL_MISSING_MODELS=true

# Maximum number of seconds to wait for a model pull to complete. Large models
# can require several minutes to download and load before use.
MODEL_PULL_TIMEOUT_SEC=7200

# Reserved for future pull retry/backoff tuning. This value is not currently used
# by the router's model-pull loop, but is retained for operator clarity.
MODEL_PULL_MAX_RETRIES=2

# Reserved for future pull retry/backoff tuning. Delay between pull retries when
# a future pull loop is enabled.
MODEL_PULL_BACKOFF_SEC=5

# -----------------------------------------------------------------------------
# Headroom-AI Context Management
# -----------------------------------------------------------------------------

# Enables the Headroom compaction layer before requests are sent to Ollama.
# Set to 0/false/off/no to bypass compaction entirely for troubleshooting.
HEADROOM_ENABLED=1

# Enables the modern recovery ladder for context-overflow errors. When enabled,
# the router tries stronger compression and segment stripping instead of only a
# legacy single-pass trim.
HEADROOM_RECOVERY_LADDER_V2=1

# Allows the router to retry with stronger Headroom compression profiles before
# moving to later, more destructive recovery steps.
HEADROOM_RECOVERY_ENABLE_STRONGER_COMPRESSION=1

# Allows optional text-block compression via Headroom text transforms when the
# runtime exposes those utilities. Missing transform modules do not fail the
# request; they simply skip this step.
HEADROOM_RECOVERY_ENABLE_TEXT_COMPRESSION=1

# Allows the final last-resort step that removes oldest complete conversation
# segments when earlier recovery attempts still exceed the model context budget.
HEADROOM_RECOVERY_ENABLE_SEGMENT_STRIPPING=1

# Maximum number of context-overflow retries the router performs after a
# material reduction succeeds. This bounds total retry churn and prevents loops.
HEADROOM_RECOVERY_MAX_RETRIES=1

# Minimum token reduction required before a recovery step is considered
# material enough to justify retrying the upstream request again.
HEADROOM_RECOVERY_MIN_TOKEN_DELTA=32

# Minimum token savings required from the segment-strip step before the router
# retries with the stripped payload.
HEADROOM_RECOVERY_MIN_STRIP_TOKEN_DELTA=1

# Minimum number of newest conversation segments to preserve while stripping
# older history. This prevents the router from deleting the whole recent thread.
HEADROOM_RECOVERY_MIN_SEGMENTS_TO_KEEP=1

# -----------------------------------------------------------------------------
# Headroom-AI Cache Configuration
# -----------------------------------------------------------------------------

# Root directory used for Hugging Face model cache and related headroom assets.
HF_HOME=/data/hf_cache

# Separate hub cache path used by transformers and model download tooling.
HUGGINGFACE_HUB_CACHE=/data/hf_cache/hub

# Model cache path for transformers runtime artifacts.
TRANSFORMERS_CACHE=/data/hf_cache/models

# Working directory for Headroom-managed runtime artifacts and generated data.
HEADROOM_WORKSPACE_DIR=/data/headroom

# Persistent storage path for Headroom CCR data used by retrieval/context
# management in deployments that enable longer-lived CCR state.
HEADROOM_CCR_STORE_PATH=/data/headroom_ccr

# -----------------------------------------------------------------------------
# Headroom-AI Compression Configuration
# -----------------------------------------------------------------------------

# Disables product telemetry from the ONNX Runtime dependency.
ORT_DISABLE_TELEMETRY=1

# Disables Hugging Face Hub telemetry used by transformers and sentence-transformers.
HF_HUB_DISABLE_TELEMETRY=1

# Enables or disables telemetry emitted by the Headroom integration. Use off in
# production unless troubleshooting compression behavior or interpreting metrics.
HEADROOM_TELEMETRY=off