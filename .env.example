# =============================================================================
# llmrouter Environment Configuration Template
# =============================================================================
# This file defines Docker Compose variables that control container image
# selection, resource allocation, and profile routing. All runtime environment
# variables are managed via the `env_file` directive in docker-compose.yml:
#
#   profiles/router.env      — Router-specific runtime variables
#   profiles/qdrant.env      — Qdrant-specific runtime variables
#   profiles/jetson/<profile>.env — Hardware-specific overrides (orin/thor)
#
# To deploy, copy this file to .env and adjust values for your environment.
# The active hardware profile is selected via HARDWARE_PROFILE (orin/thor).
# =============================================================================

# -----------------------------------------------------------------------------
# Network Configuration
# -----------------------------------------------------------------------------

# Router bind IP — the interface address on which the FastAPI router listens.
ROUTER_BIND_IP=192.168.1.20

# Router HTTP port — the port exposed by the OpenAI-compatible API router.
ROUTER_PORT=4000

# Qdrant HTTP port — the port exposed by the Qdrant vector database service.
QDRANT_PORT=6333

# -----------------------------------------------------------------------------
# Hardware Profile Selection
# -----------------------------------------------------------------------------

# Hardware profile — selects the Jetson hardware configuration to use.
# Valid values: orin, thor
# The selected profile determines which file is loaded from profiles/jetson/.
HARDWARE_PROFILE=orin

# -----------------------------------------------------------------------------
# Docker Compose Variables
# -----------------------------------------------------------------------------

# Qdrant Docker image — selects the container image for the Qdrant vector database.
# This is a Docker Compose variable (prefixed with $ in docker-compose.yml).
# It is NOT loaded via env_file; it controls the `image:` directive directly.
#
# Available images:
#   qdrant/qdrant:latest                    — CPU-only, AMD64/ARM64 compatible
#   qdrant/qdrant:gpu-nvidia-latest         — NVIDIA GPU acceleration (requires nvidia-container-toolkit)
#   qdrant/qdrant:gpu-amd-latest            — AMD GPU/Vulkan acceleration (requires vulkan-tools)
#
# IMPORTANT BREAKING CHANGE (v1.12.5 → v1.18.x):
#   Qdrant v1.18.x has a breaking on-disk segment format change. If you are
#   upgrading from v1.12.5 or earlier, you MUST remove the existing qdrant-storage
#   Docker volume before starting, otherwise Qdrant will fail to start with:
#     "unknown variant `on_disk`, expected `mmap` or `in_ram_mmap`"
#   To migrate: docker compose down && docker volume rm llmrouter_qdrant-storage
#   After upgrading, re-run document ingestion to repopulate the vector store.
QDRANT_IMAGE=qdrant/qdrant:latest

# Qdrant memory limit — the maximum container memory allocation for Qdrant.
# This is applied via Docker Compose deploy.resources.limits.memory.
# Adjust based on available system RAM and expected vector collection size.
QDRANT_MEMORY_LIMIT=4G

# -----------------------------------------------------------------------------
# Model Cache Storage Configuration
# -----------------------------------------------------------------------------

# Hugging Face model cache path — host directory for storing downloaded models.
# Default: ./data/hf_cache (relative to docker-compose.yml)
# Set to an absolute path for persistent storage outside the project directory.
# Example: /var/lib/llmrouter/hf_cache
HF_CACHE_HOST_PATH=./data/hf_cache

# Headroom CCR store path — host directory for Headroom compression cache.
# Default: ./data/headroom_ccr (relative to docker-compose.yml)
# Set to an absolute path for persistent storage outside the project directory.
# Example: /var/lib/llmrouter/headroom_ccr
HEADROOM_CCR_HOST_PATH=./data/headroom_ccr

# Qdrant storage path — host directory for Qdrant vector database storage.
# Default: ./data/qdrant_storage (relative to docker-compose.yml)
# Set to an absolute path for persistent storage outside the project directory.
# Example: /var/lib/llmrouter/qdrant_storage
QDRANT_STORAGE_HOST_PATH=./data/qdrant_storage
