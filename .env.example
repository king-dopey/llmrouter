# =============================================================================
# llmrouter Docker Compose Configuration Template
# =============================================================================
# This file defines Docker Compose variables that control container image
# selection, resource allocation, and profile routing. Runtime service
# variables are loaded separately via the `env_file` directive in
# docker-compose.yml from:
#   - profiles/router.env          (router-specific runtime variables)
#   - profiles/qdrant.env          (qdrant-specific runtime variables)
#   - profiles/jetson/<profile>.env (hardware-specific overrides)
#
# To deploy, copy this file to .env and adjust values for your environment.
# The active hardware profile is selected via HARDWARE_PROFILE (orin/thor).
# =============================================================================

# -----------------------------------------------------------------------------
# Network Configuration
# -----------------------------------------------------------------------------

# Router bind IP — the interface address on which the FastAPI router listens.
# Use 0.0.0.0 to accept connections from any network interface (LAN exposure).
# For localhost-only access, set to 127.0.0.1. Must match the ROUTER_PORT below.
# Valid: 0.0.0.0 (all interfaces), 127.0.0.1 (localhost only), <specific-IP>
ROUTER_BIND_IP=192.168.1.20

# Router HTTP port — the port exposed by the OpenAI-compatible API router.
# LibreChat and other clients connect to this port for chat completions, models,
# and embeddings endpoints. Default 4000 is conventional but can be changed.
# Valid: any unused TCP port in range 1024-65535 (default: 4000)
ROUTER_PORT=4000

# Qdrant HTTP port — the port exposed by the Qdrant vector database service.
# The router uses this port to connect to Qdrant for retrieval-augmented generation
# (RAG). Must match the QDRANT_URL in profiles/qdrant.env. Default 6333 is standard.
# Valid: any unused TCP port in range 1024-65535 (default: 6333)
QDRANT_PORT=6333

# -----------------------------------------------------------------------------
# Hardware Profile Selection
# -----------------------------------------------------------------------------

# Hardware profile — selects the Jetson hardware configuration to use.
# This determines which models.yaml policy file and hardware-specific settings
# are loaded from profiles/jetson/<PROFILE>/. The profile controls model defaults,
# embedding models, and other hardware-tuned parameters.
# Valid: orin (Jetson AGX Orin 64GB, SM 87 Ampere), thor (Jetson Thor, SM 110 Blackwell)
# Default: orin
HARDWARE_PROFILE=orin

# -----------------------------------------------------------------------------
# Docker Compose Variables
# -----------------------------------------------------------------------------

# Qdrant Docker image — selects the container image for the Qdrant vector database.
# This is a Docker Compose variable (not a runtime environment variable). The value
# is interpolated into the `image:` directive in docker-compose.yml.
# Valid: qdrant/qdrant:latest (CPU-only, multi-arch AMD64/ARM64)
# Note: For GPU-accelerated vector indexing, modify this to:
#   - qdrant/qdrant:gpu-nvidia-latest (requires nvidia-container-toolkit on host)
#   - qdrant/qdrant:gpu-amd-latest (requires Vulkan runtime on host)
QDRANT_IMAGE=qdrant/qdrant:latest

# Qdrant memory limit — the maximum container memory allocation for Qdrant.
# This is a Docker Compose variable interpolated into deploy.resources.limits.memory.
# Adjust based on available system RAM and expected vector dataset size.
# For large collections (>1M vectors), consider 8G or higher.
# Valid: any Docker-compatible memory specification (e.g., 2G, 4G, 8G, 50%)
QDRANT_MEMORY_LIMIT=4G

# -----------------------------------------------------------------------------
# Model Cache Storage Configuration
# -----------------------------------------------------------------------------

# Hugging Face model cache path — host directory for storing downloaded models.
# Default: ./data/hf_cache (relative to docker-compose.yml)
# Set to an absolute path for persistent storage outside the project directory.
# Example: /var/lib/llmrouter/hf_cache
HF_CACHE_HOST_PATH=./data/hf_cache

# Headroom CCR store path — host directory for Headroom compression cache.
# Default: ./data/headroom_ccr (relative to docker-compose.yml)
# Set to an absolute path for persistent storage outside the project directory.
# Example: /var/lib/llmrouter/headroom_ccr
# This is mounted into the router container at /data/headroom_ccr.
HEADROOM_CCR_STORE_HOST_PATH=./data/headroom_ccr

# Qdrant storage path — host directory for Qdrant vector database storage.
# Default: ./data/qdrant_storage (relative to docker-compose.yml)
# Set to an absolute path for persistent storage outside the project directory.
# Example: /var/lib/llmrouter/qdrant_storage
QDRANT_STORAGE_HOST_PATH=./data/qdrant_storage

# Headroom workspace directory — host directory for Headroom-managed runtime
# artifacts and generated data.
# Default: ./data/headroom (relative to docker-compose.yml)
# Set to an absolute path for persistent storage outside the project directory.
# Example: /var/lib/llmrouter/headroom
HEADROOM_WORKSPACE_HOST_DIR=./data/headroom
